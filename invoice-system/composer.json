{
    "name": "invoice-system/invoice-system",
    "description": "Invoice management system with PDF generation and tax calculation",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "blakvghost/php-validator": "^2.3",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "InvoiceSystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InvoiceSystem\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
